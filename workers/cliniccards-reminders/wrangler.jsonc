{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "reset-clinic-appointments-notifier",
  "main": "./index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "REMINDER_DB",
      "database_name": "reset-clinic-appointments-notifier",
      "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID"
    }
  ]
}
