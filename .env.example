# Public shop URL. On CityHost use the real subdomain.
SITE_URL=https://shop.resetclinic.org

# Persistent CityHost storage. Keep it outside the public web directory.
# Example: /home/<cityhost-user>/reset-data/shop
SHOP_DATA_DIR=

# Server-only Monobank merchant token. Never commit a real value.
MONOPAY_TOKEN=

# Temporary standalone shop admin credentials.
# After the shop section is merged into resetclinic.org/admin these can be removed.
ADMIN_LOGIN=
ADMIN_PASS=

# Vercel fallback only. Not required on CityHost when SHOP_DATA_DIR is set.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=SviatF
GITHUB_REPO_NAME=reset-clinic-shop
GITHUB_REPO_BRANCH=main
