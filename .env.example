# Server-only Monobank merchant token. Never commit a real value.
MONOPAY_TOKEN=

# Canonical public URL used for redirectUrl and webHookUrl.
SITE_URL=https://reset-clinic-shop.vercel.app

# RESET Commerce Admin credentials. Keep server-side only.
ADMIN_LOGIN=
ADMIN_PASS=

# GitHub JSON persistence. Fine-grained token needs Contents: Read and write
# access only to SviatF/reset-clinic-shop.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=SviatF
GITHUB_REPO_NAME=reset-clinic-shop
GITHUB_REPO_BRANCH=main
